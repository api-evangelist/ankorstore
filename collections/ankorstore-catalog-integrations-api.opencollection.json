              {
                "name": "Accept",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates an Operation that deletes products from Ankorstore's catalog. The operation is started directly after creation.\n"
        },
        {
          "info": {
            "name": "Retrieve an operation",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://www.ankorlocal.com:8000/api/v1/catalog/integrations/operations/:operationId",
            "headers": [
              {
                "name": "Accept",
                "value": ""
              }
