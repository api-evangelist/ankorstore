          "info": {
            "name": "Create a new operation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://www.ankorlocal.com:8000/api/v1/catalog/integrations/operations",
            "headers": [
              {
                "name": "Accept",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create new Operation to process over related Catalog Integration\n> ID of the operation will be returned on the response payload.\n  This ID should be used to add products data through `POST /catalog/integrations/operations/{ID}`\n"
        },
        {
          "info": {
            "name": "Create a deletion operation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://www.ankorlocal.com:8000/api/v1/catalog/integrations/operations/delete",
