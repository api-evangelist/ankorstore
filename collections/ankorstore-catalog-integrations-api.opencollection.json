        },
        {
          "info": {
            "name": "Patch Operation resource",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "http://www.ankorlocal.com:8000/api/v1/catalog/integrations/operations/:operationId",
            "headers": [
              {
                "name": "Accept",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "operationId",
                "value": "",
